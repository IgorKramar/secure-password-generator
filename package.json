  },
  "homepage": "https://github.com/IgorKramar/secure-password-generator#readme",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jest": "^29.6.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
